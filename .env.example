# Copy to .env and adjust for local development.
OPSMEMORY_ENVIRONMENT=development
OPSMEMORY_LOG_LEVEL=INFO
OPSMEMORY_DATABASE_URL=postgresql+asyncpg://opsmemory:opsmemory@localhost:5432/opsmemory
OPSMEMORY_API_URL=http://localhost:8000
OPSMEMORY_GRAPH_DB_PATH=./data/graph

# --- AI providers ---------------------------------------------------------
# Reasoning and embeddings are selected independently; any combination works.
#   Recommended: Gemini for embeddings + Groq for reasoning (fast + cheap)
#   Or Gemini for both. "auto" picks from whichever keys are set.
OPSMEMORY_GEMINI_API_KEY=
OPSMEMORY_GROQ_API_KEY=
# OPSMEMORY_ANTHROPIC_API_KEY=

# LLM used for reasoning/teaching extraction: auto | groq | gemini | anthropic | none
OPSMEMORY_LLM_PROVIDER=auto
# Embeddings: auto | gemini | hashing   (Groq offers no embeddings API)
OPSMEMORY_EMBEDDING_PROVIDER=auto
# OPSMEMORY_GROQ_MODEL=llama-3.3-70b-versatile
# OPSMEMORY_GEMINI_MODEL=gemini-2.5-flash
# OPSMEMORY_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# OPSMEMORY_EMBEDDING_DIMENSION=768   # must match the pgvector column

# Memory engine: native (pgvector) | cognee (requires: uv sync --extra cognee)
OPSMEMORY_MEMORY_ENGINE=native

# --- Meeting connector (Recall.ai) ----------------------------------------
OPSMEMORY_RECALL_API_KEY=
OPSMEMORY_RECALL_REGION=us-east-1
# OPSMEMORY_RECALL_WEBHOOK_SECRET=whsec_...
OPSMEMORY_RECALL_BOT_NAME=OpsMemory Notetaker

# --- Authentication -------------------------------------------------------
OPSMEMORY_AUTH_ENABLED=true
# A bootstrap admin is seeded on first startup — change these in production.
OPSMEMORY_AUTH_BOOTSTRAP_EMAIL=admin@opsmemory.local
OPSMEMORY_AUTH_BOOTSTRAP_PASSWORD=opsmemory
OPSMEMORY_AUTH_SESSION_TTL_HOURS=168
